# SpendWise Backend Environment Configuration
# Copy this file to .env and set your local values. Never commit .env!

DEBUG=True
SECRET_KEY=replace-with-a-strong-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration: 'mysql' (production/local default) or 'sqlite' (fallback/CI testing)
DB_ENGINE=mysql
DB_NAME=spendwise_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT Configuration (in minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
